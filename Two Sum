class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        unordered_map<int, int> mp;

        for (int i = 0; i < nums.size(); i++) {
            int needed = target - nums[i];

            if (mp.count(needed))
                return {mp[needed], i};

            mp[nums[i]] = i;
        }

        return {};
    }
};

Intuition: For every number, check whether its required complement has already appeared.
Algorithm: Store each number and its index in a hash map.
Key Idea: needed = target - nums[i].
Time Complexity: O(n) average
Space Complexity: O(n).
